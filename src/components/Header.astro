---
const pathname = Astro.url.pathname;
const isOnShip = pathname.startsWith('/ship');
const isOnAbout = pathname.startsWith('/about');
---

<header>
	<nav>
		<a class="back" href="/" aria-label="Home">&larr;</a>
		<div class="nav-links">
			<a href="/ship" class:list={[{ active: isOnShip }]}>Ship</a>
			<span class="sep">/</span>
			<a href="/about" class:list={[{ active: isOnAbout }]}>About</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: relative;
		padding: 0;
	}
	header::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(200,130,50,0.15) 30%, rgba(255,160,60,0.1) 50%, rgba(200,130,50,0.15) 70%, transparent);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px 24px;
	}
	.back {
		font-family: 'DM Sans', sans-serif;
		font-size: 13px;
		font-weight: 500;
		color: #c8c8d0;
		text-decoration: none;
		opacity: 0.25;
		transition: opacity 0.2s;
	}
	.back:hover {
		opacity: 0.9;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: 'DM Sans', sans-serif;
		font-size: 13px;
		font-weight: 500;
	}
	.nav-links a {
		color: #c8c8d0;
		text-decoration: none;
		opacity: 0.35;
		transition: opacity 0.2s;
	}
	.nav-links a:hover {
		opacity: 0.9;
	}
	.nav-links a.active {
		opacity: 0.9;
	}
	.sep {
		color: #c8c8d0;
		opacity: 0.2;
		user-select: none;
	}
</style>
