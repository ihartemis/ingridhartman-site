---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Embers from '../components/Embers.astro';
import { SITE_TITLE } from '../consts';
import { buildWeekCells, groupShipsByWeek, countShipsInYear, weeksLeftInYear, computeStreak } from '../lib/ship-utils';

const allShips = await getCollection('ships');

const now = new Date();
const yearForCells = 2026;

const cells = buildWeekCells(allShips, yearForCells, now);
const rawGroups = groupShipsByWeek(allShips);

// Pre-render markdown bodies. Also compute whether each ship has content
// beyond its first paragraph, so we know whether to show a "Read more →" link.
const groups = await Promise.all(
	rawGroups.map(async (group) => ({
		...group,
		ships: await Promise.all(
			group.ships.map(async (ship) => {
				const { Content } = await render(ship);
				const body = ship.body ?? '';
				const blocks = body.split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);
				const hasMore = blocks.length > 1;
				return { ...ship, Content, hasMore };
			})
		),
	}))
);

const projects = Array.from(new Set(allShips.map((s) => s.data.project))).sort();

const yearCount = countShipsInYear(allShips, yearForCells, now);
const weeksLeft = weeksLeftInYear(yearForCells, now);
const streak = computeStreak(allShips, now);

const thingsLabel = yearCount === 1 ? 'thing' : 'things';
const weeksLabel = weeksLeft === 1 ? 'week' : 'weeks';
const streakLabel = streak === 1 ? 'week' : 'weeks';
const subtitle = yearCount === 0
	? `Nothing shipped yet. ${weeksLeft} ${weeksLabel} left in the year.`
	: `${yearCount} ${thingsLabel} shipped so far. ${weeksLeft} ${weeksLabel} left in the year.`;

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Ship Log — ${SITE_TITLE}`} description="Things Ingrid shipped." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Ship Log</h1>
			<p class="subtitle">{subtitle}</p>

			<div class="stats">
				<span class="stat">
					<span class="stat-label">Streak</span>
					<span class="stat-value">{streak} {streakLabel}</span>
				</span>
			</div>

			<Embers cells={cells} year={yearForCells} />

			{projects.length > 1 && (
				<nav class="filters" aria-label="Filter by project">
					<button class="filter is-active" data-project="all" type="button">all</button>
					{projects.map((p) => (
						<button class={`filter project-${p}`} data-project={p} type="button">{p}</button>
					))}
				</nav>
			)}

			{groups.length === 0 ? (
				<p class="empty">The workshop is quiet. Check back soon.</p>
			) : (
				<div class="feed">
					{groups.map((group) => (
						<section class="week-block" id={`week-${group.week}`}>
							<header class="week-header">
								<span class="week-num">Week {group.week}</span>
								<span class="week-sep">·</span>
								<span class="week-range">{group.dateRange}</span>
							</header>
							<ul class="ship-list">
								{group.ships.map((ship) => (
									<li class={`ship effort-${ship.data.effort} kind-${ship.data.kind}`} data-project={ship.data.project}>
										<div class="ship-body">
											<div class="ship-title-row">
												<h3 class="ship-title">
													<a href={`/ship/${ship.id}`}>{ship.data.title}</a>
													{ship.data.kind === 'release' && <span class="release-label">Release notes</span>}
												</h3>
												<FormattedDate date={ship.data.date} />
											</div>
											{ship.body && ship.body.trim() && (
												<div class="ship-desc">
													<ship.Content />
												</div>
											)}
											{ship.hasMore && (
												<a class="read-more" href={`/ship/${ship.id}`}>
													Read more →
												</a>
											)}
										</div>
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			)}
		</main>
		<Footer />
		<script>
			// Project filter. Hides ships that don't match and any week left empty.
			const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
			const ships = Array.from(document.querySelectorAll<HTMLElement>('li.ship'));
			const weeks = Array.from(document.querySelectorAll<HTMLElement>('.week-block'));
			const apply = (project: string) => {
				for (const b of buttons) b.classList.toggle('is-active', b.dataset.project === project);
				for (const s of ships) s.hidden = project !== 'all' && s.dataset.project !== project;
				for (const w of weeks) w.hidden = !w.querySelector('li.ship:not([hidden])');
				try { history.replaceState(null, '', project === 'all' ? location.pathname : `?project=${project}`); } catch {}
			};
			for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.project ?? 'all'));
			const initial = new URLSearchParams(location.search).get('project');
			if (initial && buttons.some((b) => b.dataset.project === initial)) apply(initial);
		</script>
	</body>
</html>

<style>
	main {
		width: 820px;
		max-width: calc(100% - 2em);
	}

	h1 {
		margin-bottom: 0.2em;
	}

	.subtitle {
		color: var(--text-dim);
		font-size: 15px;
		font-style: italic;
		margin-bottom: 0.75em;
	}

	.stats {
		display: flex;
		gap: 1.5em;
		margin-bottom: 1.25em;
	}
	.stat {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5em;
		font-family: var(--font-heading);
	}
	.stat-label {
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-dim);
		opacity: 0.7;
	}
	.stat-value {
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
		text-shadow: 0 0 6px rgba(255, 200, 80, 0.25);
	}

	.empty {
		color: var(--text-dim);
		font-style: italic;
		margin-top: 3em;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 1.25em 0 0.25em 0;
	}
	.filter {
		font-family: var(--font-heading);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
		padding: 3px 10px;
		background: rgba(180, 120, 50, 0.06);
		border: 1px solid rgba(180, 120, 50, 0.15);
		border-radius: 12px;
		cursor: pointer;
		transition: all 0.15s;
	}
	.filter:hover {
		color: var(--text-bright);
		border-color: rgba(255, 160, 60, 0.4);
	}
	.filter.is-active {
		color: var(--accent);
		border-color: rgba(255, 200, 80, 0.5);
		background: rgba(255, 200, 80, 0.08);
	}
	.filter:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.release-label {
		display: inline-block;
		vertical-align: middle;
		margin-left: 0.6em;
		font-size: 9px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-dim);
		opacity: 0.8;
		padding: 2px 7px;
		border: 1px solid rgba(180, 120, 50, 0.22);
		border-radius: 10px;
		white-space: nowrap;
	}

	.feed {
		display: flex;
		flex-direction: column;
		gap: 2.5em;
		margin-top: 1em;
	}

	.week-block {
		scroll-margin-top: 100px;
		transition: background 0.4s ease-out;
		border-radius: 4px;
	}

	.week-block.week-flash {
		background: rgba(255, 200, 80, 0.06);
	}

	.week-header {
		font-family: var(--font-heading);
		font-size: 13px;
		color: var(--text-dim);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 1em;
		padding-bottom: 0.5em;
		border-bottom: 1px solid rgba(180, 120, 50, 0.08);
	}

	.week-num {
		color: var(--text-bright);
		font-weight: 600;
	}

	.week-sep {
		margin: 0 0.5em;
		opacity: 0.5;
	}

	.ship-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}

	.ship {
		border-left: 2px solid rgba(180, 120, 50, 0.08);
		background: rgba(255, 160, 60, 0.01);
		padding: 1em 1.25em;
		transition: all 0.15s;
	}

	.ship.effort-3 {
		border-left-color: rgba(255, 200, 80, 0.4);
		background: rgba(255, 200, 80, 0.025);
	}

	.ship.effort-2 {
		border-left-color: rgba(200, 130, 50, 0.25);
	}

	.ship:hover {
		border-left-color: rgba(255, 160, 60, 0.5);
		background: rgba(255, 160, 60, 0.03);
	}

	.ship.effort-3:hover {
		border-left-color: rgba(255, 220, 100, 0.7);
		background: rgba(255, 200, 80, 0.05);
	}

	.ship-body {
		min-width: 0;
	}

	.ship-title-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		flex-wrap: wrap;
	}

	.ship-title {
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 600;
		margin: 0;
		line-height: 1.3;
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.ship-title a {
		color: var(--text-bright);
		text-decoration: none;
		transition: color 0.15s;
	}

	.ship-title a:hover {
		color: var(--accent);
	}

	.ship-title-row :global(time) {
		font-family: var(--font-heading);
		font-weight: 400;
		color: var(--text-dim);
		font-size: 12px;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.ship-desc {
		color: var(--text);
		font-size: 15px;
		line-height: 1.6;
		margin-top: 0.4em;
		overflow-wrap: anywhere;
	}

	/* Feed preview: render only the first block of the body. Rest waits behind /ship/[slug]. */
	.ship-desc :global(> *) {
		display: none;
	}
	.ship-desc :global(> *:first-child) {
		display: block;
		margin: 0;
	}

	.read-more {
		display: inline-block;
		color: var(--link);
		font-family: var(--font-heading);
		font-size: 13px;
		text-decoration: none;
		margin-top: 0.6em;
		transition: color 0.15s;
	}

	.read-more:hover {
		color: var(--link-hover);
		text-decoration: underline;
		text-decoration-color: rgba(224, 184, 96, 0.4);
		text-underline-offset: 3px;
	}

	@media (max-width: 600px) {
		.ship-title-row {
			flex-direction: column;
			gap: 0.25em;
		}
		.ship-title {
			font-size: 16px;
		}
		.ship-row {
			gap: 0.75em;
		}
	}
</style>
