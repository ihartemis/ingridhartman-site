---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Embers from '../components/Embers.astro';
import { SITE_TITLE } from '../consts';
import { buildWeekCells, groupShipsByWeek, countShipsInYear, weeksLeftInYear, computeStreak } from '../lib/ship-utils';

const allShips = await getCollection('ships');

const now = new Date();
const yearForCells = 2026;

const cells = buildWeekCells(allShips, yearForCells, now);
const groups = groupShipsByWeek(allShips);

const yearCount = countShipsInYear(allShips, yearForCells, now);
const weeksLeft = weeksLeftInYear(yearForCells, now);
const streak = computeStreak(allShips, now);

const thingsLabel = yearCount === 1 ? 'thing' : 'things';
const weeksLabel = weeksLeft === 1 ? 'week' : 'weeks';
const streakLabel = streak === 1 ? 'week' : 'weeks';
const subtitle = yearCount === 0
	? `Nothing shipped yet. ${weeksLeft} ${weeksLabel} left in the year.`
	: `${yearCount} ${thingsLabel} shipped so far. ${weeksLeft} ${weeksLabel} left in the year.`;

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Ship Log — ${SITE_TITLE}`} description="Things Ingrid shipped." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Ship Log</h1>
			<p class="subtitle">{subtitle}</p>

			<div class="stats">
				<span class="stat">
					<span class="stat-label">Streak</span>
					<span class="stat-value">{streak} {streakLabel}</span>
				</span>
			</div>

			<Embers cells={cells} year={yearForCells} />

			{groups.length === 0 ? (
				<p class="empty">The workshop is quiet. Check back soon.</p>
			) : (
				<div class="feed">
					{groups.map((group) => (
						<section class="week-block" id={`week-${group.week}`}>
							<header class="week-header">
								<span class="week-num">Week {group.week}</span>
								<span class="week-sep">·</span>
								<span class="week-range">{group.dateRange}</span>
							</header>
							<ul class="ship-list">
								{group.ships.map((ship) => (
									<li class={`ship effort-${ship.data.effort}`}>
										<div class="ship-body">
											<div class="ship-title-row">
												<h3 class="ship-title">{ship.data.title}</h3>
												<FormattedDate date={ship.data.date} />
											</div>
											{ship.body && ship.body.trim() && (
												<div class="ship-desc" set:html={ship.body.trim()} />
											)}
											<div class="ship-meta">
												<span class={`ship-property prop-${ship.data.property}`}>{ship.data.property}</span>
												{ship.data.link && (
													<a href={ship.data.link} class="ship-link" target={ship.data.link.startsWith('http') ? '_blank' : '_self'} rel={ship.data.link.startsWith('http') ? 'noopener noreferrer' : undefined}>
														→ {ship.data.link.startsWith('/blog') ? 'Read the post' : ship.data.link.startsWith('http') ? 'See it' : 'Read more'}
													</a>
												)}
											</div>
										</div>
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 820px;
		max-width: calc(100% - 2em);
	}

	h1 {
		margin-bottom: 0.2em;
	}

	.subtitle {
		color: var(--text-dim);
		font-size: 15px;
		font-style: italic;
		margin-bottom: 0.75em;
	}

	.stats {
		display: flex;
		gap: 1.5em;
		margin-bottom: 1.25em;
	}
	.stat {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5em;
		font-family: var(--font-heading);
	}
	.stat-label {
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-dim);
		opacity: 0.7;
	}
	.stat-value {
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
		text-shadow: 0 0 6px rgba(255, 200, 80, 0.25);
	}

	.empty {
		color: var(--text-dim);
		font-style: italic;
		margin-top: 3em;
	}

	.feed {
		display: flex;
		flex-direction: column;
		gap: 2.5em;
		margin-top: 1em;
	}

	.week-block {
		scroll-margin-top: 100px;
		transition: background 0.4s ease-out;
		border-radius: 4px;
	}

	.week-block.week-flash {
		background: rgba(255, 200, 80, 0.06);
	}

	.week-header {
		font-family: var(--font-heading);
		font-size: 13px;
		color: var(--text-dim);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 1em;
		padding-bottom: 0.5em;
		border-bottom: 1px solid rgba(180, 120, 50, 0.08);
	}

	.week-num {
		color: var(--text-bright);
		font-weight: 600;
	}

	.week-sep {
		margin: 0 0.5em;
		opacity: 0.5;
	}

	.ship-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}

	.ship {
		border-left: 2px solid rgba(180, 120, 50, 0.08);
		background: rgba(255, 160, 60, 0.01);
		padding: 1em 1.25em;
		transition: all 0.15s;
	}

	.ship.effort-3 {
		border-left-color: rgba(255, 200, 80, 0.4);
		background: rgba(255, 200, 80, 0.025);
	}

	.ship.effort-2 {
		border-left-color: rgba(200, 130, 50, 0.25);
	}

	.ship:hover {
		border-left-color: rgba(255, 160, 60, 0.5);
		background: rgba(255, 160, 60, 0.03);
	}

	.ship.effort-3:hover {
		border-left-color: rgba(255, 220, 100, 0.7);
		background: rgba(255, 200, 80, 0.05);
	}

	.ship-body {
		min-width: 0;
	}

	.ship-title-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		flex-wrap: wrap;
	}

	.ship-title {
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 600;
		margin: 0;
		color: var(--text-bright);
		line-height: 1.3;
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.ship-title-row :global(time) {
		font-family: var(--font-heading);
		font-weight: 400;
		color: var(--text-dim);
		font-size: 12px;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.ship-desc {
		overflow-wrap: anywhere;
	}

	.ship-desc {
		color: var(--text);
		font-size: 15px;
		line-height: 1.6;
		margin-top: 0.4em;
	}

	.ship-desc :global(p) {
		margin: 0 0 0.6em 0;
	}

	.ship-desc :global(p:last-child) {
		margin-bottom: 0;
	}

	.ship-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1em;
		margin-top: 0.6em;
	}

	.ship-link {
		color: var(--link);
		font-family: var(--font-heading);
		font-size: 13px;
		text-decoration: none;
		transition: color 0.15s;
	}

	.ship-link:hover {
		color: var(--link-hover);
		text-decoration: underline;
		text-decoration-color: rgba(224, 184, 96, 0.4);
		text-underline-offset: 3px;
	}

	.ship-property {
		font-family: var(--font-heading);
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
		padding: 1px 5px 1px 0;
		white-space: nowrap;
		opacity: 0.75;
	}
	.ship-property::before {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		margin-right: 6px;
		background: var(--text-dim);
		vertical-align: 1px;
	}
	/* Per-property accent — just a tiny color dot */
	.ship-property.prop-ingridhartman::before { background: #c8a050; }
	.ship-property.prop-artemisnova::before   { background: #7faab4; }
	.ship-property.prop-ournanny::before      { background: #b08fc4; }
	.ship-property.prop-highvibe::before      { background: #9cc070; }
	.ship-property.prop-shipslc::before       { background: #c8a878; }
	.ship-property.prop-tinyhealth::before    { background: #80c0a0; }
	.ship-property.prop-whoop::before         { background: #c08080; }

	@media (max-width: 600px) {
		.ship-title-row {
			flex-direction: column;
			gap: 0.25em;
		}
		.ship-title {
			font-size: 16px;
		}
		.ship-row {
			gap: 0.75em;
		}
	}
</style>
