---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description="Writings on building, thinking, and wandering." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<p class="subtitle">Writings left by the fire.</p>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="title">{post.data.title}</span>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
							{post.data.description && (
								<p class="description">{post.data.description}</p>
							)}
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.5em;
	}
	.subtitle {
		color: var(--text-dim);
		font-size: 15px;
		font-style: italic;
		margin-bottom: 2.5em;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	li {
		border-left: 2px solid rgba(180,120,50,0.08);
		border-bottom: none;
		background: rgba(255,160,60,0.01);
		padding: 1.25em 1.25em 1.25em 1.5em;
		transition: all 0.15s;
	}
	li:hover {
		border-left-color: rgba(255,160,60,0.3);
		background: rgba(255,160,60,0.03);
		box-shadow: -2px 0 12px rgba(255,140,50,0.04);
	}
	li a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		text-decoration: none;
		color: var(--text-bright);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
	}
	li a:hover .title {
		color: var(--accent);
	}
	.title {
		transition: color 0.15s;
	}
	.date {
		font-family: var(--font-heading);
		font-weight: 400;
		color: var(--text-dim);
		font-size: 13px;
		white-space: nowrap;
	}
	.description {
		color: var(--text-dim);
		margin: 0.5em 0 0 0;
		font-size: 16px;
		line-height: 1.6;
	}
	@media (max-width: 600px) {
		li a {
			flex-direction: column;
			gap: 0.25em;
			font-size: 16px;
		}
	}
</style>
