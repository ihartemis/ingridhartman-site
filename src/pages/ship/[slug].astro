---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getISOWeek } from '../../lib/ship-utils';

export async function getStaticPaths() {
	const ships = await getCollection('ships');
	return ships.map((ship) => ({
		params: { slug: ship.id },
		props: { ship },
	}));
}

const { ship } = Astro.props;
const { Content } = await render(ship);
const iso = getISOWeek(ship.data.date);

const link = ship.data.link;
const linkLabel = !link
	? null
	: link.includes('github.com')
		? 'Open the repo'
		: link.startsWith('/')
			? 'Read it on the site'
			: 'See it live';
const linkIsExternal = !!link && link.startsWith('http');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${ship.data.title} — ${SITE_TITLE}`} description={ship.data.title} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href={`/ship#week-${iso.week}`}>← back to ship log</a>

			<header class="ship-header">
				<h1>{ship.data.title}</h1>
				<FormattedDate date={ship.data.date} />
			</header>

			{ship.data.thumbnail && (
				<figure class="thumbnail">
					<Image src={ship.data.thumbnail} alt={ship.data.title} />
				</figure>
			)}

			<article class="ship-body">
				<Content />
				{link && (
					<a
						class="see-it-live"
						href={link}
						target={linkIsExternal ? '_blank' : '_self'}
						rel={linkIsExternal ? 'noopener noreferrer' : undefined}
					>
						→ {linkLabel}
					</a>
				)}
			</article>

			{(ship.data.before || ship.data.after) && (
				<div class:list={['progression', { 'progression-pair': ship.data.before && ship.data.after }]}>
					{ship.data.before && (
						<figure class="prog-cell">
							<Image src={ship.data.before} alt={`Before — ${ship.data.title}`} />
							<figcaption>Before</figcaption>
						</figure>
					)}
					{ship.data.after && (
						<figure class="prog-cell">
							<Image src={ship.data.after} alt={`After — ${ship.data.title}`} />
							<figcaption>After</figcaption>
						</figure>
					)}
				</div>
			)}

			<hr class="divider" />

			<footer class="meta">
				<div class="meta-row">
					<span class={`chip medium-${ship.data.medium}`}>{ship.data.medium}</span>
					<span class={`chip project project-${ship.data.project}`}>{ship.data.project}</span>
				</div>
				{ship.data.tools && ship.data.tools.length > 0 && (
					<div class="meta-row tools-row">
						<span class="meta-label">TOOLS</span>
						{ship.data.tools.map((tool) => (
							<span class="chip tool">{tool}</span>
						))}
					</div>
				)}
			</footer>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 720px;
		max-width: calc(100% - 2em);
	}

	.back-link {
		display: inline-block;
		color: var(--text-dim);
		font-family: var(--font-heading);
		font-size: 12px;
		text-decoration: none;
		letter-spacing: 0.05em;
		opacity: 0.7;
		transition: opacity 0.2s;
		margin-bottom: 2em;
	}
	.back-link:hover {
		opacity: 1;
		color: var(--link);
	}

	.ship-header {
		margin-bottom: 1em;
	}

	.ship-header h1 {
		margin-bottom: 0.2em;
		line-height: 1.15;
	}

	.ship-header :global(time) {
		font-family: var(--font-heading);
		font-size: 13px;
		color: var(--text-dim);
		letter-spacing: 0.03em;
	}

	.thumbnail {
		margin: 1.5em 0 2.25em 0;
		padding: 0;
	}
	.thumbnail :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
		border: 1px solid rgba(180, 120, 50, 0.18);
		background: rgba(0, 0, 0, 0.2);
	}

	.progression {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1em;
		margin: 2.5em 0 1.5em 0;
	}
	.progression.progression-pair {
		grid-template-columns: 1fr 1fr;
	}
	.prog-cell {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.prog-cell :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
		border: 1px solid rgba(180, 120, 50, 0.18);
		background: rgba(0, 0, 0, 0.2);
	}
	.prog-cell figcaption {
		font-family: var(--font-heading);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--text-dim);
		opacity: 0.7;
	}

	@media (max-width: 600px) {
		.progression.progression-pair {
			grid-template-columns: 1fr;
		}
	}

	.ship-body {
		font-size: 16px;
		line-height: 1.7;
		color: var(--text);
		/* Flex column lets us reorder children: first content block, then see-it-live link, then the rest. */
		display: flex;
		flex-direction: column;
	}

	/* Default order for Content's rendered children. */
	.ship-body :global(> *) {
		order: 3;
	}
	/* First block of the body shows first. */
	.ship-body :global(> *:first-child) {
		order: 1;
	}
	/* See-it-live link slips in right after the first block. */
	.ship-body > .see-it-live {
		order: 2;
		align-self: flex-start;
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		margin: 0.2em 0 1.6em 0;
		transition: all 0.15s;
		text-shadow: 0 0 8px rgba(255, 200, 80, 0.2);
	}
	.ship-body > .see-it-live:hover {
		color: #ffe88a;
		text-decoration: underline;
		text-decoration-color: rgba(255, 220, 120, 0.6);
		text-underline-offset: 4px;
	}

	.ship-body :global(p) {
		margin: 0 0 1.2em 0;
	}

	.ship-body :global(h2) {
		font-family: var(--font-heading);
		font-size: 22px;
		font-weight: 600;
		color: var(--text-bright);
		margin: 1.8em 0 0.6em 0;
		line-height: 1.3;
	}

	.ship-body :global(h3) {
		font-family: var(--font-heading);
		font-size: 18px;
		font-weight: 600;
		color: var(--text-bright);
		margin: 1.4em 0 0.5em 0;
	}

	.ship-body :global(blockquote) {
		margin: 1.2em 0;
		padding: 0.4em 0 0.4em 1.2em;
		border-left: 2px solid rgba(200, 130, 50, 0.4);
		color: var(--text-dim);
		font-style: italic;
	}

	.ship-body :global(code) {
		background: rgba(255, 200, 80, 0.08);
		padding: 0.1em 0.35em;
		border-radius: 3px;
		font-size: 0.92em;
		color: var(--text-bright);
	}

	.ship-body :global(pre) {
		background: rgba(0, 0, 0, 0.3);
		padding: 1em 1.2em;
		border-radius: 4px;
		overflow-x: auto;
		margin: 1.2em 0;
		border: 1px solid rgba(180, 120, 50, 0.12);
	}

	.ship-body :global(pre code) {
		background: none;
		padding: 0;
	}

	.ship-body :global(a) {
		color: var(--link);
		text-decoration: underline;
		text-decoration-color: rgba(224, 184, 96, 0.3);
		text-underline-offset: 3px;
	}
	.ship-body :global(a:hover) {
		color: var(--link-hover);
	}

	.ship-body :global(ul),
	.ship-body :global(ol) {
		margin: 0 0 1.2em 0;
		padding-left: 1.4em;
	}

	.ship-body :global(li) {
		margin-bottom: 0.4em;
	}

	.divider {
		border: none;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(180, 120, 50, 0.2), transparent);
		margin: 3em 0 1.5em 0;
	}

	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
	}

	.meta-label {
		font-family: var(--font-heading);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--text-dim);
		opacity: 0.6;
		margin-right: 0.25em;
	}

	.chip {
		font-family: var(--font-heading);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-dim);
		padding: 3px 9px;
		background: rgba(180, 120, 50, 0.06);
		border: 1px solid rgba(180, 120, 50, 0.15);
		border-radius: 12px;
		white-space: nowrap;
	}

	.chip.project::before {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		margin-right: 6px;
		background: var(--text-dim);
		vertical-align: 1px;
	}
	.chip.project.project-ingridhartman::before { background: #c8a050; }
	.chip.project.project-artemisnova::before   { background: #7faab4; }
	.chip.project.project-ournanny::before      { background: #b08fc4; }
	.chip.project.project-highvibe::before      { background: #9cc070; }
	.chip.project.project-shipslc::before       { background: #c8a878; }
	.chip.project.project-tinyhealth::before    { background: #80c0a0; }
	.chip.project.project-whoop::before         { background: #c08080; }

	.chip.medium-writing { color: #d4a560; border-color: rgba(212, 165, 96, 0.25); }
	.chip.medium-web     { color: #c89045; border-color: rgba(200, 144, 69, 0.25); }
	.chip.medium-app     { color: #b08fc4; border-color: rgba(176, 143, 196, 0.25); }
	.chip.medium-media   { color: #7faab4; border-color: rgba(127, 170, 180, 0.25); }
	.chip.medium-other   { color: var(--text-dim); }

	.chip.tool {
		text-transform: lowercase;
		letter-spacing: 0.04em;
	}

	@media (max-width: 600px) {
		main {
			width: 100%;
		}
		.ship-header h1 {
			font-size: 28px;
		}
	}
</style>
