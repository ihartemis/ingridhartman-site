---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="post-header">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									(updated <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr />
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
			<div class="back-link">
				<a href="/blog">&larr; Back to the fire</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 65ch;
	}
	.post-header {
		margin-bottom: 2.5em;
	}
	.date {
		font-family: var(--font-heading);
		color: var(--text-dim);
		font-size: 13px;
		margin-bottom: 1em;
	}
	.updated {
		font-style: italic;
	}
	h1 {
		margin: 0.5em 0;
		font-size: 32px;
	}
	hr {
		border: none;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(200,130,50,0.2) 20%, rgba(255,160,60,0.15) 50%, rgba(200,130,50,0.2) 80%, transparent);
		margin: 1.5em 0 0 0;
	}
	.prose {
		font-size: 18px;
		line-height: 1.8;
		color: var(--text);
	}
	.prose :global(a) {
		color: var(--link);
		text-decoration: underline;
		text-decoration-color: rgba(200,160,80,0.3);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.15s;
	}
	.prose :global(a:hover) {
		color: var(--link-hover);
		text-decoration-color: rgba(224,184,96,0.6);
	}
	.prose :global(p) {
		margin-bottom: 1.8em;
	}
	.prose :global(h2) {
		margin-top: 2.5em;
	}
	.prose :global(h3) {
		margin-top: 2em;
	}
	.back-link {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgba(180,120,50,0.12);
	}
	.back-link a {
		color: var(--text-dim);
		font-family: var(--font-heading);
		font-size: 14px;
		text-decoration: none;
		transition: color 0.15s;
	}
	.back-link a:hover {
		color: var(--link);
	}
</style>
